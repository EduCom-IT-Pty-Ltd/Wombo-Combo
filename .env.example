# Copy to .env.local. With no DATABASE_URL the app runs against the in-memory
# demo dataset in src/lib/data/demo-data.ts — every screen works, writes are
# logged rather than persisted.

# --- Database (Neon) ---------------------------------------------------------
# Neon connection string, pooled endpoint. Use a branch per environment.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"

# Force the demo dataset even when DATABASE_URL is set.
# DEMO_MODE=true

# --- Auth (WorkOS AuthKit) ---------------------------------------------------
# WORKOS_API_KEY="sk_test_..."
# WORKOS_CLIENT_ID="client_..."
# WORKOS_COOKIE_PASSWORD="at least 32 characters, generate with: openssl rand -base64 32"
# NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"

# --- Uploaded branding images ------------------------------------------------
# Organisation logo and quote letterhead. REQUIRED IN PRODUCTION: without it the
# code falls back to writing into public/, which fails on Vercel (read-only
# filesystem, and runtime writes there are not served). Add Blob storage to the
# Vercel project and this is set automatically.
# BLOB_READ_WRITE_TOKEN=

# --- SharePoint / Microsoft Graph --------------------------------------------
# App registration in the customer's M365 tenant, app-only client credentials
# with Sites.Selected granted against one site. `npm run graph:check` verifies.
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# SHAREPOINT_SITE_ID="host,siteCollectionId,siteId"
# SHAREPOINT_ROOT_FOLDER="Projects"

# --- Xero (Web App / OAuth 2.0) ----------------------------------------------
# The refresh token is not configured here: it rotates on every use and is held
# in Postgres. Xero rejects http and localhost redirects in production.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI="http://localhost:3000/api/xero/callback"
# Encrypts stored Xero tokens. openssl rand -hex 32 — a DIFFERENT one per env.
# XERO_TOKEN_KEY=
